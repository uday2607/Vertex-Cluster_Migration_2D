# Compiled C++ objects and binaries
obj/
*.o
*.out

# Simulation output data (large, generated by the C++ binaries)
DATA/POS_GAMMA_HETERO/
DATA/POS_GAMMA_VERTEX_HETERO/

# Keep example data committed (small synthetic files for demos and tests)
!DATA/EXAMPLES/

# Generated results (movies, processed data, plots) from real simulation runs
RESULTS/MOVIES/*.mp4
RESULTS/MOVIES/*.gif
RESULTS/PROCESSED_DATA/POS_GAMMA_HETERO/
RESULTS/PROCESSED_DATA/POS_GAMMA_VERTEX_HETERO/

# Keep example results committed
!RESULTS/MOVIES/example_*.gif
!RESULTS/MOVIES/example_*.mp4
!RESULTS/PLOTS/example_*.png
!RESULTS/PROCESSED_DATA/EXAMPLES/
!RESULTS/PROCESSED_DATA/ensemble_summary.csv
!RESULTS/PROCESSED_DATA/ensemble_aggregates.json

# Temporary movie frame directories
_tmp_*/

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Editor / OS
.DS_Store
*.swp
*~
